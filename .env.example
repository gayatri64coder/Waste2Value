# ==============================================================================
# waste2value - Environment Configuration Template
# ==============================================================================
# COPY THIS FILE TO .env (or .env.development / .env.production)
# DO NOT COMMIT THE ACTUAL .env FILE CONTAINING REAL SECRETS TO GIT
# ==============================================================================

# Application Environment: development | testing | production
APP_ENV=development

# ------------------------------------------------------------------------------
# 1. Firebase Configuration
# ------------------------------------------------------------------------------
# Primary Android Firebase configuration is loaded via:
#   android/app/google-services.json
# (Supplied by project owner/Firebase Console -> Project Settings -> General -> Your apps -> google-services.json)
#
# Optional Dart-define overrides (if building for web / iOS / custom flavor):
FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
FIREBASE_STORAGE_BUCKET=YOUR_FIREBASE_STORAGE_BUCKET
FIREBASE_MESSAGING_SENDER_ID=YOUR_FIREBASE_SENDER_ID

# ------------------------------------------------------------------------------
# 2. Google Maps API Key
# ------------------------------------------------------------------------------
# Obtain from Google Cloud Console: APIs & Services -> Credentials -> Create API Key
# Required APIs to enable: Maps SDK for Android, Maps JavaScript API, Places API
# Placeholder:
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY

# ------------------------------------------------------------------------------
# 3. Optional Future AI API Key (Post-MVP only)
# ------------------------------------------------------------------------------
# The MVP uses offline, zero-cost rule-based valuation, device inspection heuristics,
# and a local intelligent FAQ chatbot. No paid external AI API is required.
# If integrating Gemini or OpenAI in the future, set the key here (NEVER hardcode in source):
# AI_API_KEY=YOUR_OPTIONAL_AI_API_KEY
AI_API_KEY=

# ------------------------------------------------------------------------------
# 4. Optional Backend Service URLs (if using Cloud Functions or custom REST API)
# ------------------------------------------------------------------------------
API_BASE_URL=https://us-central1-YOUR_FIREBASE_PROJECT_ID.cloudfunctions.net
